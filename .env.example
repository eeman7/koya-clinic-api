NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection string. To use Neon, paste its URL here, e.g.
#   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:pw@localhost:54329/clinic"

# Clients must send this in the X-API-Key header
API_KEY=replace-with-a-long-random-string
