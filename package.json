{
  "name": "koya-clinic-api",
  "version": "1.0.0",
  "description": "Clinic appointment booking API and web page",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/db/data-source.ts",
    "db:migrate": "pnpm typeorm migration:run",
    "db:migrate:generate": "pnpm typeorm migration:generate src/db/migrations/Migration"
  },
  "packageManager": "pnpm@10.30.3",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
